<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-03-15-008-create-document-review-seq" author="daniyal">
        <createSequence sequenceName="document_review_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="2026-03-15-008-create-document-reviews" author="daniyal">
        <createTable tableName="document_reviews">
            <column name="id" type="BIGINT" defaultValueSequenceNext="document_review_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_doc_review_document"
                             references="documents(id)"/>
            </column>
            <column name="lawyer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_doc_review_lawyer"
                             references="users(id)"/>
            </column>
            <column name="notes" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="risk_level" type="VARCHAR(20)"/>
            <column name="recommended" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="document_reviews" indexName="idx_doc_reviews_document_id">
            <column name="document_id"/>
        </createIndex>
        <createIndex tableName="document_reviews" indexName="idx_doc_reviews_lawyer_id">
            <column name="lawyer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
