<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-03-15-004-create-document-versions-seq" author="daniyal">
        <createSequence sequenceName="document_version_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="2026-03-15-004-create-document-versions" author="daniyal">
        <createTable tableName="document_versions">
            <column name="id" type="BIGINT" defaultValueSequenceNext="document_version_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_doc_version_document"
                             references="documents(id)"/>
            </column>
            <column name="version" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="s3_object_key" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="document_versions"
                             columnNames="document_id, version"
                             constraintName="uq_doc_version"/>
    </changeSet>

</databaseChangeLog>
