<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-02-24-001-create-sequences" author="Orynbek Daniyal">
        <comment>Create all sequences for ID generation</comment>

        <createSequence sequenceName="role_seq_gen"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>

        <createSequence sequenceName="user_seq_gen"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>

        <createSequence sequenceName="user_role_seq_gen"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>

        <createSequence sequenceName="verification_code_seq_gen"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>

        <createSequence sequenceName="refresh_token_seq"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>

        <createSequence sequenceName="lawyer_app_seq"
                        startValue="1"
                        incrementBy="1"
                        minValue="1"
                        cycle="false"/>

        <rollback>
            <dropSequence sequenceName="role_seq_gen"/>
            <dropSequence sequenceName="user_seq_gen"/>
            <dropSequence sequenceName="user_role_seq_gen"/>
            <dropSequence sequenceName="verification_code_seq_gen"/>
            <dropSequence sequenceName="refresh_token_seq"/>
            <dropSequence sequenceName="lawyer_app_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>