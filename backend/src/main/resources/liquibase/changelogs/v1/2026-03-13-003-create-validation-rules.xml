<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        validation_rules — правила валидации полей документа.
        Адвокат задаёт: поле + оператор + ожидаемое значение + сообщение об ошибке.
        Пример: fieldKey="rent_amount" operator="GREATER_THAN" expectedValue="0"
                errorMessage="Сумма аренды должна быть больше нуля"
    -->
    <changeSet id="2026-03-13-003-create-validation-rules" author="dev">
        <createTable tableName="validation_rules">

            <!-- PK -->
            <column name="id" type="BIGINT" defaultValueSequenceNext="validation_rule_seq">
                <constraints primaryKey="true" primaryKeyName="pk_validation_rules" nullable="false"/>
            </column>

            <!-- FK → templates -->
            <column name="template_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_validation_rules_template"
                             references="templates(id)"/>
            </column>

            <!-- бизнес-поля -->
            <column name="field_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="field_label" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!--
                operator — enum RuleConditionOperator:
                IS_EMPTY, IS_NOT_EMPTY, EQUALS, NOT_EQUALS,
                CONTAINS, GREATER_THAN, LESS_THAN,
                GREATER_OR_EQUAL, LESS_OR_EQUAL
            -->
            <column name="operator" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <!-- null для операторов IS_EMPTY / IS_NOT_EMPTY -->
            <column name="expected_value" type="VARCHAR(500)"/>

            <column name="error_message" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <!-- аудит -->
            <column name="created_by" type="VARCHAR(100)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>

        </createTable>

        <!-- индекс для быстрого поиска по шаблону -->
        <createIndex tableName="validation_rules" indexName="idx_validation_rules_template_active">
            <column name="template_id"/>
            <column name="active"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>