<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2026-02-24-005-create-verification-code" author="Orynbek Daniyal">
        <comment>Create verification_code table for email confirmation and password reset</comment>

        <createTable tableName="verification_code">
            <column name="id" type="BIGINT" defaultValueSequenceNext="verification_code_seq_gen">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_verification_code"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="expired_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <!-- Audit fields -->
            <column name="created_by" type="VARCHAR(100)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
        </createTable>

        <!-- Index for frequent query: find latest unused code by email+type -->
        <createIndex tableName="verification_code" indexName="idx_verification_email_type_used">
            <column name="email"/>
            <column name="type"/>
            <column name="used"/>
        </createIndex>

        <rollback>
            <dropTable tableName="verification_code"/>
        </rollback>
    </changeSet>

</databaseChangeLog>